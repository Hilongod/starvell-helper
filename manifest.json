{
  "manifest_version": 3,
  "name": "Starvell Helper",
  "version": "2.1.3",
  "description": "Автоподнятие лотов, автотикеты в поддержку, статистика продаж, кастомный фон и многое другое для Starvell",

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "cookies",
    "scripting"
  ],

  "host_permissions": [
    "https://starvell.com/*",
    "https://*.starvell.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://starvell.com/*"],
      "css": ["content.css"],
      "run_at": "document_start",
      "js": [
        "content/01-core.js",
        "content/02-dashboard.js",
        "content/03-ui-extras.js"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["sounds/*"],
      "matches": ["https://starvell.com/*"]
    }
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
